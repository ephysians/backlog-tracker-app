VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ANTHROPIC_API_KEY is NOT set here. Vite bundles every VITE_* variable into
# the client-side JS, so a server-only secret must never use that prefix or
# live in this file. Set ANTHROPIC_API_KEY directly in your Vercel project's
# environment variables instead, it's only ever read by api/triage.js on
# the server.
